{
  "name": "expo-passkey-liveness",
  "version": "0.1.0-alpha.0",
  "description": "Optional liveness-detection extension for expo-passkey: face presentation-attack-detection (PAD) gating for registration, authentication, and recovery flows",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "android",
    "ios",
    "app.plugin.js",
    "ExpoPasskeyLivenessModule.podspec",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "expo-module.config.json"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "type-check": "tsc --noEmit",
    "test": "expo-module test",
    "test:client": "jest --selectProjects client --passWithNoTests",
    "test:server": "jest --selectProjects server --passWithNoTests",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module"
  },
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.js"
    },
    "./native": {
      "types": "./build/index.native.d.ts",
      "import": "./build/index.native.js",
      "require": "./build/index.native.js"
    },
    "./web": {
      "types": "./build/index.web.d.ts",
      "import": "./build/index.web.js",
      "require": "./build/index.web.js"
    },
    "./server": {
      "types": "./build/server/index.d.ts",
      "import": "./build/server/index.js",
      "require": "./build/server/index.js"
    },
    "./providers/rekognition": {
      "types": "./build/server/providers/rekognition.d.ts",
      "import": "./build/server/providers/rekognition.js",
      "require": "./build/server/providers/rekognition.js"
    },
    "./providers/iproov": {
      "types": "./build/server/providers/iproov.d.ts",
      "import": "./build/server/providers/iproov.js",
      "require": "./build/server/providers/iproov.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "./build/server/index.d.ts"
      ],
      "native": [
        "./build/index.native.d.ts"
      ],
      "web": [
        "./build/index.web.d.ts"
      ],
      "providers/rekognition": [
        "./build/server/providers/rekognition.d.ts"
      ],
      "providers/iproov": [
        "./build/server/providers/iproov.d.ts"
      ]
    }
  },
  "keywords": [
    "expo",
    "react-native",
    "expo-passkey",
    "liveness",
    "presentation-attack-detection",
    "pad",
    "biometric",
    "anti-spoofing",
    "deepfake",
    "face-liveness",
    "iso-30107",
    "fido",
    "better-auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iosazee/expo-passkey-liveness.git"
  },
  "bugs": {
    "url": "https://github.com/iosazee/expo-passkey-liveness/issues"
  },
  "author": "Zee Mudia <zee@zeemudia.com> (https://github.com/iosazee)",
  "license": "MIT",
  "homepage": "https://github.com/iosazee/expo-passkey-liveness#readme",
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@jest/globals": "^30.0.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.3",
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "better-auth": "^1.3.7",
    "better-call": "^1.0.9",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-universe": "^15.0.3",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "expo": "~53.0.11",
    "expo-modules-core": "2.4.0",
    "expo-module-scripts": "^4.1.7",
    "expo-passkey": "*",
    "globals": "^16.3.0",
    "jest": "^30.0.0",
    "jest-expo": "^53.0.7",
    "jose": "^5.9.6",
    "react-native": "0.76.0",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.0.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@aws-sdk/client-rekognition": ">=3.600.0",
    "@better-auth/expo": ">=1.0.0",
    "@better-fetch/fetch": ">=1.0.0",
    "@iproov/react-native": ">=8.0.0",
    "better-auth": ">=1.0.0",
    "better-call": ">=1.0.0",
    "expo": ">=50.0.0",
    "expo-modules-core": ">=2.0.0",
    "expo-passkey": ">=0.3.12",
    "jose": ">=5.0.0",
    "react": ">=18.3.1",
    "react-native": "*",
    "zod": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-rekognition": {
      "optional": true
    },
    "@iproov/react-native": {
      "optional": true
    },
    "@better-auth/expo": {
      "optional": true
    },
    "@better-fetch/fetch": {
      "optional": true
    },
    "better-auth": {
      "optional": true
    },
    "better-call": {
      "optional": true
    },
    "expo": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}
